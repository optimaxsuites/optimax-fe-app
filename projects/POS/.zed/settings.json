// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"autosave": "off",
	// disable the built-in HTML extension auto-install if you like
	// "auto_install_extensions": {
	//   "html": false
	// },

	"languages": {
		// "HTML": {
		//   // prepend "angular", then fall back to the rest (...)
		//   "language_servers": ["angular", "!vscode-html-language-server", "..."]
		// },
		// "TypeScript": {
		//   // ensure TS files also use Angular first
		//   "language_servers": ["angular", "..."]
		// }
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": false,
				"source.organizeImports.biome": true
			}
		}
	}

	// "lsp": {
