{
    "version": 2,
    "builds": [
      {
        "src": "dist/optimax_fe_app/**",
        "use": "@vercel/static",
        "external": ["zone.js"]
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ],
    "engines": {
      "node": "18.x"
    }
  }