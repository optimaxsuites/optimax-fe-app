{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OptimaXERP",
  "version": "2026.11.2",
  "identifier": "com.optimaxsuites.erp",
  "build": {
    "frontendDist": "../dist/erp-fe/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npx ng serve",
    "beforeBuildCommand": "npx ng build ERP-FE --configuration tauri --base-href ./"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.optimaxsuites.com/latest.json"
      ],
      "dialog": false,
      "pubkey": ""
    }
  }
}
